# Haircut simulator providers. Without keys the simulator runs in a clearly
# labeled TEST mode (fixed analysis, previews return the original photo), so
# the repo runs with no keys and no cost.
GOOGLE_AI_STUDIO_KEY=
KIE_API_KEY=
GOOGLE_VISION_MODEL=gemini-3.5-flash
GOOGLE_IMAGE_MODEL=gemini-3-pro-image
# 1 = force TEST mode even with keys present. Unset to go live.
MOCK_AI=1

# 1 = save every simulator session (inputs, generated views, verdicts) to
# data/simulator-sessions for the improvement log at /simulator/history.
# BUILD-TIME flag: it flips the privacy copy with it. Keep OFF in production;
# serverless filesystems are ephemeral and visitors have not consented.
NEXT_PUBLIC_SIM_STORE=

# Vercel Blob for the improvement log (auto-injected on Vercel once the store
# is connected; pull locally with: vercel env pull). Private store, faces stay
# behind the token.
BLOB_READ_WRITE_TOKEN=
# fs forces the local-disk backend (QA uses this to spare Blob operations)
SIM_STORE_BACKEND=
